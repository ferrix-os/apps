// The window: the header with the mark and the steps, the page's title,
// its rows, each drawn by its kind, and the foot with Back and Next.
// Rust makes the rows for the page shown (`src/pages.rs`) and turns what
// is pressed into changes.
import Fx

enum RowKind {
    // The mark (or a tick, or a cross), a big title, a line.
    Hero,
    // A heading over cards.
    Section,
    // A card to choose, a dot before it.
    Radio,
    // A short row in a list to choose from.
    Pick,
    // A labelled line to type in, and its note.
    Field,
    // A card of warning, red when something is erased.
    Warning,
    // Lines of label and value.
    Info,
    // A card with a segmented choice.
    Choice,
    // The progress bar and the step.
    Progress,
    // A line of the log.
    Log,
    // Big buttons, side by side.
    Buttons,
    // A quiet button: Show details.
    Link,
    // Words alone, faint.
    Empty
}

struct PageRow {
    kind: RowKind
    title: string
    desc: string
    tag: string
    shown: string
    note: string
    level: int
    on: bool
    enabled: bool
    options: list<string>
    values: list<string>
    current: int
    value: real
}

struct StepRow {
    label: string
    // 0 done, 1 now, 2 to come.
    state: int
}

export component Shell : Rectangle {
    id: shell
    property list<StepRow> steps
    property string title
    property string subtitle
    property model<PageRow> rows
    property painter mark
    property bool foot
    property bool canBack
    property bool hasNext
    property bool canNext
    property string nextLabel
    property string backLabel: "Back"
    property string status
    // The column the page is in.
    property real column: min(shell.width - 96, 660)
    property real left: (shell.width - shell.column) / 2
    property real top: shell.title == "" ? 88 : 146

    signal pressed(int row, int option)
    signal edited(int row, string text)
    signal accepted(int row)
    signal back()
    signal next()

    color: Look.bg

    // The header: the mark and the name, then the steps.
    Canvas {
        x: 28; y: 21
        width: 28; height: 22
        painter: shell.mark
    }
    Text {
        x: 66; y: 12
        height: 40
        text: "Install Ferrix"
        font: Look.sans(17, 600)
        color: Look.text
    }
    Row {
        x: shell.width - 28 - width
        y: 12
        height: 40
        spacing: 16
        Repeater {
            model: shell.steps
            Item {
                width: dot.width + 6 + name.implicitWidth
                height: 40
                Rectangle {
                    id: dot
                    y: 16
                    width: modelData.state == 1 ? 18 : 8
                    height: 8
                    radius: 4
                    color: modelData.state == 2 ? Look.line2 : Look.accent
                }
                Text {
                    id: name
                    x: dot.width + 6
                    height: 40
                    text: modelData.label
                    font: Look.sans(13, modelData.state == 1 ? 600 : 500)
                    color: modelData.state == 1 ? Look.text : modelData.state == 0 ? Look.muted : Look.faint
                }
            }
        }
    }
    Rectangle {
        y: 63
        width: shell.width
        height: 1
        color: Look.line
    }

    // The page's title.
    Text {
        visible: shell.title != ""
        x: shell.left
        y: 80
        text: shell.title
        font: Look.sans(26, 600)
        color: Look.text
    }
    Text {
        visible: shell.title != ""
        x: shell.left
        y: 114
        text: shell.subtitle
        font: Look.sans(14)
        color: Look.muted
    }

    ListView {
        id: body
        x: shell.left
        y: shell.top
        width: shell.column
        height: shell.height - shell.top - (shell.foot ? 80 : 16)
        clip: true
        model: shell.rows
        delegate: DelegateChooser {
            role: "kind"
            DelegateChoice {
                roleValue: RowKind.Hero
                Item {
                    width: body.width
                    height: modelData.title == "" ? 96 : 236
                    Canvas {
                        visible: modelData.tag == "mark"
                        x: (body.width - 152) / 2
                        y: 18
                        width: 152; height: 116
                        painter: shell.mark
                    }
                    Rectangle {
                        visible: modelData.tag == "done" || modelData.tag == "error"
                        x: (body.width - 96) / 2
                        y: modelData.title == "" ? 0 : 28
                        width: 96; height: 96
                        radius: 48
                        color: modelData.tag == "done" ? Look.accentSoft : Look.dangerSoft
                        border.width: 2
                        border.color: modelData.tag == "done" ? Look.accent : Look.dangerLine
                        Shape {
                            visible: modelData.tag == "done"
                            x: 28; y: 30
                            width: 40; height: 36
                            ShapePath {
                                strokeColor: Look.accentText; strokeWidth: 5; fillColor: "transparent"
                                capStyle: ShapePath.RoundCap; joinStyle: ShapePath.RoundJoin
                                startX: 3; startY: 19
                                PathLine { x: 14; y: 30 }
                                PathLine { x: 37; y: 5 }
                            }
                        }
                        Shape {
                            visible: modelData.tag == "error"
                            x: 30; y: 30
                            width: 36; height: 36
                            ShapePath {
                                strokeColor: Look.danger; strokeWidth: 5
                                capStyle: ShapePath.RoundCap
                                startX: 4; startY: 4
                                PathLine { x: 32; y: 32 }
                            }
                            ShapePath {
                                strokeColor: Look.danger; strokeWidth: 5
                                capStyle: ShapePath.RoundCap
                                startX: 32; startY: 4
                                PathLine { x: 4; y: 32 }
                            }
                        }
                    }
                    Text {
                        id: heroTitle
                        visible: modelData.title != ""
                        x: (body.width - implicitWidth) / 2
                        y: 150
                        text: modelData.title
                        font: Look.sans(32, 600)
                        color: Look.text
                    }
                    Text {
                        visible: modelData.desc != ""
                        x: (body.width - implicitWidth) / 2
                        y: 198
                        text: modelData.desc
                        font: Look.sans(16)
                        color: Look.muted
                    }
                }
            }
            DelegateChoice {
                roleValue: RowKind.Section
                Item {
                    width: body.width
                    height: 40
                    Text {
                        y: 12
                        height: 20
                        text: modelData.title
                        font: Look.sans(14, 600)
                        color: Look.muted
                    }
                    Text {
                        x: body.width - width
                        y: 12
                        height: 20
                        text: modelData.tag
                        font: Look.sans(14, 600)
                        color: Look.accentText
                    }
                }
            }
            DelegateChoice {
                roleValue: RowKind.Radio
                Item {
                    width: body.width
                    height: card.height + 6
                    Rectangle {
                        id: card
                        width: body.width
                        height: max(words.implicitHeight + 24, 60)
                        radius: 12
                        color: modelData.on ? (modelData.level == 2 ? Look.dangerSoft : Look.accentSoft) : radioArea.containsMouse && modelData.enabled ? Look.hover : Look.card
                        border.width: 1
                        border.color: modelData.on ? (modelData.level == 2 ? Look.dangerLine : Look.accent) : Look.line
                        opacity: modelData.enabled ? 1 : 0.5
                        Dot {
                            x: 20
                            anchors.verticalCenter: parent.verticalCenter
                            on: modelData.on
                        }
                        Column {
                            id: words
                            x: 56
                            anchors.verticalCenter: parent.verticalCenter
                            spacing: 3
                            Text { text: modelData.title; font: Look.sans(15, 600); color: Look.text }
                            Text { visible: modelData.desc != ""; text: modelData.desc; font: Look.sans(13); color: Look.muted }
                            Item { visible: modelData.values.length > 0; width: 1; height: 4 }
                            Repeater {
                                model: modelData.values
                                Text { height: 19; text: modelData; font: Look.sans(13.5, 500); color: Look.danger }
                            }
                        }
                        Text {
                            x: card.width - 20 - width
                            y: 0
                            height: 60
                            text: modelData.tag
                            font: Look.sans(15, 600)
                            color: modelData.on ? Look.accentText : Look.muted
                        }
                        MouseArea {
                            id: radioArea
                            anchors.fill: parent
                            hoverEnabled: true
                            cursorShape: Qt.PointingHandCursor
                            onClicked: if (modelData.enabled) { shell.pressed(index, 0) }
                        }
                    }
                }
            }
            DelegateChoice {
                roleValue: RowKind.Pick
                Item {
                    width: body.width
                    height: 42
                    Rectangle {
                        width: body.width
                        height: 38
                        radius: 9
                        color: modelData.on ? Look.accentSoft : pickArea.containsMouse ? Look.hover : "transparent"
                        border.width: modelData.on ? 1 : 0
                        border.color: Look.accent
                        Text {
                            x: 16
                            height: 38
                            text: modelData.title
                            font: Look.sans(15, modelData.on ? 600 : 500)
                            color: modelData.on ? Look.accentText : Look.text
                        }
                        Text {
                            x: parent.width - (modelData.on ? 44 : 16) - width
                            height: 38
                            text: modelData.tag
                            font: Look.mono(12)
                            color: Look.faint
                        }
                        Tick {
                            visible: modelData.on
                            x: parent.width - 30
                            y: 11
                            color: Look.accentText
                        }
                        MouseArea {
                            id: pickArea
                            anchors.fill: parent
                            hoverEnabled: true
                            cursorShape: Qt.PointingHandCursor
                            onClicked: shell.pressed(index, 0)
                        }
                    }
                }
            }
            DelegateChoice {
                roleValue: RowKind.Field
                Item {
                    width: body.width
                    height: box.y + box.height + (modelData.note == "" ? 10 : 26)
                    Text {
                        visible: modelData.title != ""
                        height: 18
                        text: modelData.title
                        font: Look.sans(14, 600)
                        color: Look.muted
                    }
                    Rectangle {
                        id: box
                        y: modelData.title == "" ? 0 : 22
                        width: body.width
                        height: modelData.tag == "big" ? 50 : 40
                        radius: 10
                        color: Look.inset
                        border.width: input.activeFocus ? 1.5 : 1
                        border.color: input.activeFocus ? Look.accent : modelData.note != "" && modelData.level == 2 ? Look.dangerLine : Look.line2
                        Shape {
                            visible: modelData.tag == "search"
                            x: 14; y: 11
                            width: 18; height: 18
                            ShapePath {
                                strokeColor: Look.faint; strokeWidth: 1.6; fillColor: "transparent"
                                PathCircle { centerX: 8; centerY: 8; radius: 5.5 }
                            }
                            ShapePath {
                                strokeColor: Look.faint; strokeWidth: 1.6
                                startX: 12.2; startY: 12.2
                                PathLine { x: 15.5; y: 15.5 }
                            }
                        }
                        Text {
                            x: modelData.tag == "search" ? 42 : 16
                            height: parent.height
                            visible: input.text == ""
                            text: modelData.desc
                            font: Look.sans(modelData.tag == "big" ? 16 : 15)
                            color: Look.faint
                        }
                        TextInput {
                            id: input
                            x: modelData.tag == "search" ? 42 : 16
                            width: parent.width - x - 16
                            height: parent.height
                            text: modelData.shown
                            echoMode: modelData.tag == "password" ? TextInput.Password : TextInput.Normal
                            font: Look.sans(modelData.tag == "big" ? 16 : 15)
                            color: Look.text
                            cursorColor: Look.text
                            selectionColor: alpha(Look.accent, 0.35)
                            activeFocusOnTab: true
                            onTextEdited: shell.edited(index, text)
                            onAccepted: shell.accepted(index)
                        }
                        MouseArea {
                            anchors.fill: parent
                            cursorShape: Qt.IBeamCursor
                            onPressed: input.forceActiveFocus()
                        }
                    }
                    Text {
                        visible: modelData.note != ""
                        x: 2
                        y: box.y + box.height + 4
                        height: 18
                        text: modelData.note
                        font: Look.sans(13, modelData.level == 0 ? 400 : 500)
                        color: modelData.level == 2 ? Look.danger : modelData.level == 1 ? Look.warn : Look.faint
                    }
                }
            }
            DelegateChoice {
                roleValue: RowKind.Warning
                Item {
                    width: body.width
                    height: warning.height + 10
                    Rectangle {
                        id: warning
                        y: 4
                        width: body.width
                        height: lines.implicitHeight + 30
                        radius: 12
                        color: modelData.level == 2 ? Look.dangerSoft : modelData.level == 1 ? Look.warnSoft : Look.card
                        border.width: 1
                        border.color: modelData.level == 2 ? Look.dangerLine : modelData.level == 1 ? Look.warn : Look.line
                        Caution {
                            visible: modelData.level > 0
                            x: 18; y: 16
                            color: modelData.level == 2 ? Look.danger : Look.warn
                        }
                        Column {
                            id: lines
                            x: modelData.level > 0 ? 50 : 20
                            y: 15
                            spacing: 3
                            Text {
                                height: 22
                                text: modelData.title
                                font: Look.sans(15, 600)
                                color: modelData.level == 2 ? Look.danger : modelData.level == 1 ? Look.warn : Look.text
                            }
                            Repeater {
                                model: modelData.values
                                Text {
                                    height: 20
                                    text: modelData
                                    font: Look.sans(14)
                                    color: Look.text
                                }
                            }
                        }
                    }
                }
            }
            DelegateChoice {
                roleValue: RowKind.Info
                Item {
                    width: body.width
                    height: info.height + 8
                    InfoCard {
                        id: info
                        width: body.width
                        labels: modelData.options
                        values: modelData.values
                    }
                }
            }
            DelegateChoice {
                roleValue: RowKind.Choice
                Item {
                    width: body.width
                    height: card.height + 8
                    Rectangle {
                        id: card
                        width: body.width
                        height: 72
                        radius: 12
                        color: Look.card
                        border.width: 1
                        border.color: Look.line
                        Column {
                            x: 20
                            anchors.verticalCenter: parent.verticalCenter
                            spacing: 3
                            Text { text: modelData.title; font: Look.sans(15, 600); color: Look.text }
                            Text { text: modelData.desc; font: Look.sans(13); color: Look.muted }
                        }
                        Segmented {
                            x: card.width - width - 16
                            anchors.verticalCenter: parent.verticalCenter
                            options: modelData.options
                            current: modelData.current
                            onPicked: shell.pressed(index, option)
                        }
                    }
                }
            }
            DelegateChoice {
                roleValue: RowKind.Progress
                Item {
                    width: body.width
                    height: 96
                    Text {
                        y: 14
                        height: 24
                        text: modelData.title
                        font: Look.sans(16, 600)
                        color: Look.text
                    }
                    Text {
                        x: body.width - width
                        y: 14
                        height: 24
                        text: modelData.tag
                        font: Look.sans(15, 600)
                        color: Look.accentText
                    }
                    Rectangle {
                        y: 52
                        width: body.width
                        height: 10
                        radius: 5
                        color: Look.inset
                        border.width: 1
                        border.color: Look.line
                        Rectangle {
                            width: max(parent.width * clamp(modelData.value, 0, 1), modelData.value > 0 ? 10 : 0)
                            height: 10
                            radius: 5
                            color: Look.accent
                        }
                    }
                }
            }
            DelegateChoice {
                roleValue: RowKind.Log
                Rectangle {
                    width: body.width
                    height: 22
                    color: Look.inset
                    Text {
                        x: 14
                        width: body.width - 28
                        height: 22
                        elide: Text.ElideRight
                        text: modelData.title
                        font: Look.mono(12)
                        color: Look.muted
                    }
                }
            }
            DelegateChoice {
                roleValue: RowKind.Buttons
                Item {
                    width: body.width
                    height: modelData.desc == "" ? 84 : 108
                    ButtonRow {
                        x: (body.width - width) / 2
                        y: 20
                        options: modelData.options
                        current: modelData.current
                        onPicked: shell.pressed(index, option)
                    }
                    Text {
                        visible: modelData.desc != ""
                        x: (body.width - implicitWidth) / 2
                        y: 84
                        height: 20
                        text: modelData.desc
                        font: Look.sans(13)
                        color: Look.faint
                    }
                }
            }
            DelegateChoice {
                roleValue: RowKind.Link
                Item {
                    width: body.width
                    height: 44
                    Rectangle {
                        y: 4
                        width: linkWords.implicitWidth + 44
                        height: 34
                        radius: 8
                        color: linkArea.containsMouse ? Look.hover : "transparent"
                        Text {
                            id: linkWords
                            x: 12
                            height: 34
                            text: modelData.title
                            font: Look.sans(14, 600)
                            color: Look.accentText
                        }
                        Chevron {
                            x: linkWords.implicitWidth + 22
                            y: 14
                            open: modelData.on
                            color: Look.accentText
                        }
                        MouseArea {
                            id: linkArea
                            anchors.fill: parent
                            hoverEnabled: true
                            cursorShape: Qt.PointingHandCursor
                            onClicked: shell.pressed(index, 0)
                        }
                    }
                }
            }
            DelegateChoice {
                roleValue: RowKind.Empty
                Item {
                    width: body.width
                    height: 36
                    Text {
                        x: 16
                        height: 30
                        text: modelData.title
                        font: Look.sans(14)
                        color: Look.faint
                    }
                }
            }
        }
    }

    // How far down the page's rows are, when they do not all fit.
    Rectangle {
        visible: body.contentHeight > body.height + 12
        x: shell.left + shell.column + 14
        y: body.y + body.height * clamp(body.contentY / max(body.contentHeight, 1), 0, 1)
        width: 4
        height: max(body.height * min(body.height / max(body.contentHeight, 1), 1), 24)
        radius: 2
        color: Look.line2
    }

    // The foot: Back, what went wrong, Next.
    Item {
        visible: shell.foot
        y: shell.height - 72
        width: shell.width
        height: 72
        Rectangle { width: parent.width; height: 1; color: Look.line }
        Button {
            x: shell.left
            y: 16
            label: shell.backLabel
            live: shell.canBack
            visible: shell.canBack
            onClicked: shell.back()
        }
        Text {
            x: shell.left + 200
            width: shell.column - 330
            y: 16
            height: 40
            elide: Text.ElideRight
            text: shell.status
            font: Look.sans(13)
            color: Look.danger
        }
        Button {
            visible: shell.hasNext
            x: shell.left + shell.column - width
            y: 16
            label: shell.nextLabel
            primary: true
            live: shell.canNext
            onClicked: shell.next()
        }
    }
}
